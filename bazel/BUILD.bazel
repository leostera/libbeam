  tools = ["@libbeam_host//:perl", "//libbeam:tools/otp/beam_makeops"],
  outs = ["opcode_upstream_repeat/beam_opcodes.c", "opcode_upstream_repeat/beam_opcodes.h", "opcode_upstream_repeat/beam_hot.h", "opcode_upstream_repeat/beam_warm.h", "opcode_upstream_repeat/beam_cold.h"],
