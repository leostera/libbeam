genrule(
  name = "atom_upstream",
  visibility = ["//libbeam:__pkg__"],
  srcs = ["//libbeam:core/otp/atom.names", "//libbeam:core/otp/bif.tab"],
  tools = ["@libbeam_host//:perl", "//libbeam:tools/otp/make_tables"],
  outs = ["atom_upstream/erl_atom_table.c", "atom_upstream/erl_atom_table.h", "atom_upstream/erl_bif_table.h"],
  cmd = "$(location @libbeam_host//:perl) $(location //libbeam:tools/otp/make_tables) -src $(RULEDIR)/atom_upstream -include $(RULEDIR)/atom_upstream $(location //libbeam:core/otp/atom.names) $(location //libbeam:core/otp/bif.tab)",
)

genrule(
  name = "atom_upstream_repeat",
