genrule(
  name = "opcode_upstream",
  visibility = ["//libbeam:__pkg__"],
  srcs = ["//libbeam:core/otp/opcodes/genop.tab", "//libbeam:core/otp/opcodes/predicates.tab", "//libbeam:core/otp/opcodes/generators.tab", "//libbeam:core/otp/opcodes/emu/ops.tab", "//libbeam:core/otp/opcodes/emu/predicates.tab", "//libbeam:core/otp/opcodes/emu/generators.tab", "//libbeam:core/otp/opcodes/emu/macros.tab", "//libbeam:core/otp/opcodes/emu/instrs.tab", "//libbeam:core/otp/opcodes/emu/arith_instrs.tab", "//libbeam:core/otp/opcodes/emu/bif_instrs.tab", "//libbeam:core/otp/opcodes/emu/bs_instrs.tab", "//libbeam:core/otp/opcodes/emu/float_instrs.tab", "//libbeam:core/otp/opcodes/emu/map_instrs.tab", "//libbeam:core/otp/opcodes/emu/msg_instrs.tab", "//libbeam:core/otp/opcodes/emu/select_instrs.tab", "//libbeam:core/otp/opcodes/emu/trace_instrs.tab"],
  tools = ["@libbeam_host//:perl", "//libbeam:tools/otp/beam_makeops"],
  outs = ["opcode_upstream/beam_opcodes.c", "opcode_upstream/beam_opcodes.h", "opcode_upstream/beam_hot.h", "opcode_upstream/beam_warm.h", "opcode_upstream/beam_cold.h"],
  cmd = "root=$$PWD; out=\"$$root/$(RULEDIR)/opcode_upstream\"; cd libbeam/core/otp/opcodes; LANG=C \"$$root/$(location @libbeam_host//:perl)\" \"$$root/$(location //libbeam:tools/otp/beam_makeops)\" -wordsize 64 -jit no -DUSE_VM_PROBES=0 -outdir \"$$out\" -emulator genop.tab predicates.tab generators.tab emu/ops.tab emu/predicates.tab emu/generators.tab emu/macros.tab emu/instrs.tab emu/arith_instrs.tab emu/bif_instrs.tab emu/bs_instrs.tab emu/float_instrs.tab emu/map_instrs.tab emu/msg_instrs.tab emu/select_instrs.tab emu/trace_instrs.tab",
)

genrule(
