genrule(
  name = "preloaded_beam",
  srcs = ["preloaded_source"],
  tools = ["@libbeam_host//:otp", "@libbeam_host//:otp/bin/erlc"],
  outs = ["fixtures/preloaded_beam/erlang.beam"],
  cmd = "ERL_FLAGS='+S 1:1 +SDcpu 1:1 +SDio 1 +A 0' $(location @libbeam_host//:otp/bin/erlc) +deterministic  -o $(@D) $(location :preloaded_source)",
)

genrule(
  name = "preloaded_embedding",
  srcs = ["preloaded_beam"],
  tools = ["preloaded_generator"],
  outs = ["preloaded_fixture.inc"],
  cmd = "$(location :preloaded_generator) embed $(location :preloaded_beam) $@",
)

