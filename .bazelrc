# Incremental local development. Bazel keeps separate caches for each config.
build --compilation_mode=dbg
# Enforce project warnings without imposing them on third-party internals.
build --per_file_copt=libbeam/.*@-Wall,-Wextra,-Werror
build --verbose_failures
test --test_output=errors
build:release --compilation_mode=opt
# UBSan otherwise shares dbg's output directory and overwrites its local outputs.
build:ubsan --platform_suffix=ubsan
build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize-recover=all
build:ubsan --linkopt=-fsanitize=undefined
# Coverage-guided fuzz campaigns; keep separate from the normal Bazel config.
build:asan-libfuzzer --action_env=CC=clang
build:asan-libfuzzer --action_env=CXX=clang++
build:asan-libfuzzer --@rules_fuzzing//fuzzing:cc_engine=@rules_fuzzing//fuzzing/engines:libfuzzer
build:asan-libfuzzer --@rules_fuzzing//fuzzing:cc_engine_instrumentation=libfuzzer
build:asan-libfuzzer --@rules_fuzzing//fuzzing:cc_engine_sanitizer=asan
